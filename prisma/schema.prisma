
generator client {
  provider = "prisma-client-js"
  output = "../src/shared/generated/client"
}

generator zod {
  provider = "zod-prisma-types"
  output = "../src/shared/generated/schemas"
}
datasource db {
  provider = "postgresql"
}
enum Type {
  entrada
  saida
}

enum Category {
  food
  transport
  education
  health
  other
  salary
  investment
} 

model Transaction {
  id String @id @default(uuid())
  type Type
  category Category
  /// @zod.number.positive({message: "O valor deve ser positivo"})
  value Float
  date DateTime @default(now())
  /// @zod.string.min(5, {message: "A descrição deve ter no mínimo 5 caracteres"})
  desc String
  userID String
  User User @relation(fields: [userID], references: [id])
}

model User {
  id String @id @default(uuid())
  /// @zod.string
  name String @unique
  /// @zod.string.min(8, { message: "A senha deve ter no mínimo 8 caracteres" })
  password String
  transactions Transaction[]
}